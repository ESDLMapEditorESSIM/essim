{
  "datasource": "${DS_ESSIM}",
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineInterpolation": "stepAfter",
        "barAlignment": 0,
        "lineWidth": 1,
        "fillOpacity": 10,
        "gradientMode": "none",
        "spanNulls": true,
        "showPoints": "never",
        "pointSize": 5,
        "stacking": {
          "mode": "none",
          "group": "A"
        },
        "axisPlacement": "auto",
        "axisLabel": "",
        "scaleDistribution": {
          "type": "linear"
        },
        "hideFrom": {
          "tooltip": false,
          "viz": false,
          "legend": false
        },
        "thresholdsStyle": {
          "mode": "off"
        }
      },
      "color": {
        "mode": "palette-classic"
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          }
        ]
      },
      "mappings": [],
      "unit": "percentunit"
    },
    "overrides": [
      {
        "matcher": {
          "id": "byFrameRefID",
          "options": "A"
        },
        "properties": [
          {
            "id": "displayName",
            "value": "${__field.labels[\"assetclass\"]} (${__field.labels[\"assetname\"]} ${__field.labels[\"address\"]})"
          }
        ]
      }
    ]
  },
  "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 17
  },
  "id": 8,
  "links": [],
  "options": {
    "tooltip": {
      "mode": "single"
    },
    "legend": {
      "displayMode": "table",
      "placement": "right",
      "calcs": [
        "mean"
      ]
    }
  },
  "pluginVersion": "8.2.5",
  "targets": [
    {
      "refId": "A",
      "rawSql": "SELECT time, tags->>'assetName' AS assetName, tags->>'assetClass' AS assetClass, tags->>'address' AS address,load FROM $ScenarioName$.$$$TRANSPORT-SOLVER-NAME$$$ WHERE (tags->>'simulationRun' = '$SimulationRun$' AND tags->>'capability' = 'Transport' AND $__timeFilter(time)) ORDER BY time ASC",
      "rawQuery": true,
      "alias": "$assetClass ($assetName, $address)",
      "resultFormat": "time_series",
      "format": "time_series",
      "group": [],
      "metricColumn": "none",
      "select": [
        [
          {
            "params": [
              "value"
            ],
            "type": "column"
          }
        ]
      ],
      "timeColumn": "time",
      "where": [
        {
          "name": "$__timeFilter",
          "params": [],
          "type": "macro"
        }
      ]
    }
  ],
  "timeFrom": null,
  "timeShift": null,
  "title": "$$$TRANSPORT-SOLVER-NAME$$$ Transport loads (in %)",
  "transparent": true,
  "type": "timeseries"
}