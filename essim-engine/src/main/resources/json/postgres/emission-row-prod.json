{
  "id": 5,
  "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 9
  },
  "type": "timeseries",
  "title": "Hourly Emission (in tonnes CO₂) per Producer",
  "datasource": "${DS_ESSIM}",
  "links": [],
  "targets": [
    {
      "refId": "A",
      "rawSql": "SELECT timestamp '1970-01-01' as time, result_value FROM $ScenarioName$.execute_query_on_multiple_tables('$ScenarioName$', 'SELECT tags->>''assetName'' || '','' || tags->>''assetClass''  as group_by_label, SUM(emission)/1000 AS result_value FROM {TABLE_NAME} WHERE (tags->>''simulationRun'' = ''$$SimulationRunName$$'' AND tags->>''capability'' = ''Producer'') GROUP BY tags->>''assetName'', tags->>''assetClass''') WHERE result_value IS NOT NULL",
      "rawQuery": true,
      "alias": "$tag_assetClass ($tag_assetName)",
      "resultFormat": "time_series",
      "format": "time_series"
    }
  ],
  "transparent": true,
  "options": {
    "tooltip": {
      "mode": "single"
    },
    "legend": {
      "displayMode": "table",
      "placement": "right",
      "calcs": [
        "sum"
      ]
    }
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "drawStyle": "line",
        "lineInterpolation": "linear",
        "barAlignment": 0,
        "lineWidth": 1,
        "fillOpacity": 10,
        "gradientMode": "none",
        "spanNulls": true,
        "showPoints": "never",
        "pointSize": 5,
        "stacking": {
          "mode": "none",
          "group": "A"
        },
        "axisPlacement": "auto",
        "axisLabel": "",
        "scaleDistribution": {
          "type": "linear"
        },
        "hideFrom": {
          "tooltip": false,
          "viz": false,
          "legend": false
        },
        "thresholdsStyle": {
          "mode": "off"
        }
      },
      "color": {
        "mode": "palette-classic"
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "value": null,
            "color": "green"
          },
          {
            "value": 80,
            "color": "red"
          }
        ]
      },
      "mappings": [],
      "unit": "masst",
      "decimals": 2
    },
    "overrides": []
  },
  "pluginVersion": "8.2.5",
  "timeFrom": null,
  "timeShift": null
}
