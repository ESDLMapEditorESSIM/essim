    {
      "alias": "tonnes of CO₂",
      "colorMode": null,
      "colors": [
        "rgba(245, 54, 54, 0.9)",
        "rgba(237, 129, 40, 0.89)",
        "rgba(50, 172, 45, 0.97)"
      ],
      "decimals": 2,
      "pattern": "Value",
      "thresholds": [
      ],
      "type": "number",
      "unit": "short"
    }
  ],
  "targets": [
    {
      "refId": "A",
      "query": "SELECT sum(emission) / 1000 AS emission_kg FROM /.*/ WHERE simulationRun = '$$SimulationRunName$$' AND capability = 'Producer' GROUP BY carrierName ORDER BY time ASC",
