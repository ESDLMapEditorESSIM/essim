{
  "openapi": "3.0.0",
  "info": {
    "title": "ESSIM REST Services",
    "version": "v3"
  },
  "servers": [ {"url": "/essim"} ],
  "paths": {
    "/simulation": {
      "post": {
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedStatus"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorStatus"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Create and start a simulation run",
        "operationId": "POST_simulation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EssimSimulation"
              }
            }
          },
          "required": true
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EssimSimulation"
                  }
                }
              }
            }
          }
        },
        "description": "Get all Simulation Runs",
        "operationId": "GET_simulation"
      }
    },
    "/simulation/status": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Get status of current ESSIM instance",
        "operationId": "GET_simulation-status"
      }
    },
    "/simulation/kpiModules": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KPIModuleInfo"
                  }
                }
              }
            }
          }
        },
        "description": "Get all KPI Modules",
        "operationId": "GET_simulation-kpiModules"
      }
    },
    "/simulation/{simulationId}": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EssimSimulation"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "Get information of simulation run",
        "operationId": "GET_simulation-simulationId"
      },
      "put": {
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "Get information of simulation run",
        "operationId": "PUT_simulation-simulationId",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EssimSimulation"
              }
            }
          },
          "required": true
        }
      },
      "parameters": [
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/kpi": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Get KPIs of simulation run",
        "operationId": "GET_simulation-simulationId-kpi"
      },
      "parameters": [
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/kpi/{kpiId}": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "Get KPI calculation results",
        "operationId": "GET_simulation-simulationId-kpi-kpiId"
      },
      "parameters": [
        {
          "name": "kpiId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/status": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "Give status of this simulation",
        "operationId": "GET_simulation-simulationId-status"
      },
      "parameters": [
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/load_animation": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "operationId": "GET_simulation-simulationId-load_animation"
      },
      "parameters": [
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/transport": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransportNetwork"
                  }
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "List all transport networks created in this simulation run",
        "operationId": "GET_simulation-simulationId-transport"
      },
      "parameters": [
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/simulation/{simulationId}/transport/{index}": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportNetwork"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "description": "Get description of Transport Network",
        "operationId": "GET_simulation-simulationId-transport-index"
      },
      "parameters": [
        {
          "name": "index",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "simulationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "enum": [
          "CREATED",
          "RUNNING",
          "COMPLETE",
          "ERROR"
        ],
        "type": "string"
      },
      "OrderPreference": {
        "enum": [
          "FIRST",
          "LAST"
        ],
        "type": "string"
      },
      "CreatedStatus": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "id"
        ]
      },
      "ErrorStatus": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "description"
        ]
      },
      "SimulationStatus": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/Status"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "description"
        ]
      },
      "TransportNetwork": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "networkHTMLDiag": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "networkHTMLDiag"
        ]
      },
      "ExternalSolver": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "orderPreference": {
            "$ref": "#/components/schemas/OrderPreference"
          }
        },
        "required": [
          "name",
          "url"
        ]
      },
      "KPIModule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "config"
        ]
      },
      "RemoteKPIModule": {
        "type": "object",
        "properties": {
          "kafkaURL": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KPIModule"
            }
          }
        },
        "required": [
          "kafkaURL",
          "modules"
        ]
      },
      "EssimSimulation": {
        "type": "object",
        "properties": {
          "esdlContents": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "scenarioID": {
            "type": "string"
          },
          "simulationDescription": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "timeStep": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SimulationStatus"
          },
          "influxURL": {
            "type": "string"
          },
          "csvFilesLocation": {
            "type": "string"
          },
          "natsURL": {
            "type": "string"
          },
          "mqttURL": {
            "type": "string"
          },
          "amqpURL": {
            "type": "string"
          },
          "mso": {
            "$ref": "#/components/schemas/MSOConfiguration"
          },
          "kafkaURL": {
            "type": "string"
          },
          "externalSolvers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalSolver"
            }
          },
          "kpiModule": {
            "$ref": "#/components/schemas/RemoteKPIModule"
          },
          "simRunDate": {
            "type": "string",
            "format": "date-time"
          },
          "transport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransportNetwork"
            }
          },
          "dashboardURL": {
            "type": "string"
          },
          "loadAnimationJSON": {
            "type": "string"
          },
          "nodeConfig": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeConfiguration"
            }
          }
        },
        "required": [
          "esdlContents",
          "user",
          "scenarioID",
          "simulationDescription",
          "startDate",
          "endDate",
          "timeStep",
          "status",
          "mso"
        ]
      },
      "MSOConfiguration": {
        "type": "object",
        "properties": {
          "mqttHost": {
            "type": "string"
          },
          "mqttPort": {
            "type": "integer"
          }
        },
        "required": [
          "mqttHost",
          "mqttPort"
        ]
      },
      "NodeConfiguration": {
        "type": "object",
        "properties": {
          "esdlNodeId": {
            "type": "string"
          },
          "config": {
            "type": "object"
          },
          "mqttHost": {
            "type": "string"
          },
          "mqttPort": {
            "type": "integer"
          },
          "mqttTopic": {
            "type": "string"
          }
        },
        "required": [
          "esdlNodeId",
          "config",
          "mqttHost",
          "mqttPort",
          "mqttTopic"
        ]
      },
      "KPIModuleInfo": {
        "type": "object",
        "properties": {
          "calculator_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "config_config": {
            "type": "object"
          },
          "sample_output": {
            "type": "string"
          },
          "kafka_consumer_group": {
            "type": "string"
          },
          "kafka_client": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "up_since": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "calculator_id",
          "title",
          "description",
          "config_config",
          "sample_output",
          "kafka_consumer_group",
          "kafka_client",
          "status",
          "up_since"
        ]
      }
    },
    "responses": {},
    "parameters": {},
    "examples": {},
    "requestBodies": {},
    "headers": {},
    "securitySchemes": {},
    "links": {},
    "callbacks": {}
  }
}